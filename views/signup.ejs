<%- include('partials/header') %>

<main class="d-flex align-items-center justify-content-center flex-grow-1 px-3 py-4">
  <div class="card login-card signup-card w-100">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <div class="brand-mark mb-2">SecDash</div>
        <div class="text-muted small">관리자 계정 만들기</div>
      </div>

      <% if (errors.length) { %>
        <div class="alert alert-danger py-2 small">
          <ul class="mb-0 ps-3"><% errors.forEach(msg => { %><li><%= msg %></li><% }) %></ul>
        </div>
      <% } %>

      <form action="/signup" method="post" autocomplete="off">
        <div class="mb-3">
          <label class="form-label small" for="username">아이디</label>
          <input class="form-control" id="username" name="username" value="<%= form.username || '' %>"
                 pattern="[A-Za-z0-9_]{4,20}" maxlength="20" placeholder="영문/숫자/_ 4~20자" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label small" for="name">이름</label>
          <input class="form-control" id="name" name="name" maxlength="50" value="<%= form.name || '' %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label small" for="email">이메일 <span class="text-muted">(선택)</span></label>
          <input class="form-control" type="email" id="email" name="email" maxlength="100" value="<%= form.email || '' %>">
        </div>
        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="form-label small" for="password">비밀번호</label>
            <input class="form-control" type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
          </div>
          <div class="col-6">
            <label class="form-label small" for="password2">비밀번호 확인</label>
            <input class="form-control" type="password" id="password2" name="password2" minlength="8" maxlength="72" autocomplete="new-password" required>
          </div>
          <div class="form-text">8자 이상</div>
        </div>
        <div class="mb-3 pt-3 border-top">
          <div class="form-label small">계정 종류</div>
          <div class="row g-2">
            <div class="col-6">
              <input type="radio" class="btn-check" name="role" id="role_viewer" value="ANALYST" <%= form.role !== 'ADMIN' ? 'checked' : '' %>>
              <label class="role-option d-block" for="role_viewer">
                <div class="fw-semibold small">조회 계정</div>
                <div class="text-muted" style="font-size: .75rem;">공격 유형, 조치 내역 보기</div>
              </label>
            </div>
            <div class="col-6">
              <input type="radio" class="btn-check" name="role" id="role_admin" value="ADMIN" <%= form.role === 'ADMIN' ? 'checked' : '' %>>
              <label class="role-option d-block" for="role_admin">
                <div class="fw-semibold small">관리자 계정</div>
                <div class="text-muted" style="font-size: .75rem;">모든 기능 사용</div>
              </label>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label small" for="signup_code">가입 비밀번호</label>
          <input class="form-control mono" type="password" id="signup_code" name="signup_code" required>
          <div class="form-text">관리자에게 받은 가입용 비밀번호를 입력하세요.</div>
        </div>
        <div class="mb-4" id="adminCodeBox" <%= form.role === 'ADMIN' ? '' : 'hidden' %>>
          <label class="form-label small" for="admin_code">관리자 암호</label>
          <input class="form-control mono" type="password" id="admin_code" name="admin_code" autocomplete="off">
          <div class="form-text">관리자 계정은 관리자 암호도 입력해야 만들 수 있습니다.</div>
        </div>
        <button class="btn btn-accent w-100">계정 만들기</button>
      </form>

      <div class="text-center mt-3 small">
        <a href="/login">로그인으로 돌아가기</a>
      </div>
    </div>
  </div>
<%# </main>은 footer에서 닫음 %>
<%- include('partials/footer') %>
