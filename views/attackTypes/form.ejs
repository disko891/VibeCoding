<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<h3 class="page-title mb-3"><%= title %></h3>

<% if (errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0 ps-3"><% errors.forEach(msg => { %><li><%= msg %></li><% }) %></ul>
  </div>
<% } %>

<form class="card form-narrow" method="post" action="<%= isEdit ? `/attack-types/${item.id}/edit` : '/attack-types' %>">
  <div class="card-body row g-3">
    <div class="col-md-8">
      <label class="form-label">유형명</label>
      <input name="name" class="form-control" maxlength="100" value="<%= item.name || '' %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">코드</label>
      <input name="code" class="form-control mono text-uppercase" maxlength="30" value="<%= item.code || '' %>" placeholder="SQLI" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">기본 위험도</label>
      <select name="default_severity" class="form-select">
        <% SEVERITIES.forEach(s => { %>
          <option <%= item.default_severity === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12">
      <label class="form-label">설명</label>
      <textarea name="description" class="form-control" rows="3"><%= item.description || '' %></textarea>
    </div>
  </div>
  <div class="card-footer d-flex justify-content-end gap-2">
    <a href="/attack-types" class="btn btn-outline-secondary">취소</a>
    <button class="btn btn-accent"><%= isEdit ? '저장' : '등록' %></button>
  </div>
</form>

<%- include('../partials/footer') %>
