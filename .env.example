# 사용법: cp .env.example .env 후 [필수] 항목을 채운다

PORT=3000
# 비워두면 같은 네트워크의 다른 PC에서도 접속 가능 (이 PC에서만: 127.0.0.1)
HOST=
# EC2 배포 시 production 으로 변경
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
# [필수] MySQL 계정
DB_USER=root
DB_PASSWORD=
DB_NAME=security_db

# [필수 - production일 때] 세션 서명용 비밀값, 비어 있으면 서버가 시작되지 않음
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 로그인 10회 실패로 차단됐을 때 해제용 비밀번호
LOGIN_UNLOCK_CODE=1234

# 로그인 화면에서 계정 만들 때 필요한 가입 비밀번호
SIGNUP_CODE=1234

# nginx 뒤에 둘 때만 true
TRUST_PROXY=false

# 관리자 계정을 만들 때 가입 비밀번호와 함께 입력해야 하는 암호
ADMIN_SIGNUP_CODE=P@ssw0rd

# 이 시간(분) 동안 아무 요청이 없으면 자동 로그아웃 (같은 계정 중복 로그인 막는 기준도 됨)
SESSION_IDLE_MIN=30
